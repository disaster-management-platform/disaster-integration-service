/subsystem=datasources/data-source=Integration:add(jndi-name=java:jboss/datasources/Integration,driver-name=postgresql-42.7.7.jar,connection-url="jdbc:postgresql://${env.INTEGRATION_DB_HOST}:${env.INTEGRATION_DB_PORT:5432}/${env.INTEGRATION_DB_NAME:postgres}?sslmode=verify-full&sslrootcert=${env.INTEGRATION_DB_CA}&connectTimeout=${env.INTEGRATION_DB_CONNECT_TIMEOUT:5}&socketTimeout=${env.INTEGRATION_DB_SOCKET_TIMEOUT:30}",user-name="${env.INTEGRATION_DB_USER}",password="${env.INTEGRATION_DB_PASSWORD}",min-pool-size=${env.INTEGRATION_DB_POOL_MIN:0},max-pool-size=${env.INTEGRATION_DB_POOL_MAX:8},blocking-timeout-wait-millis=${env.INTEGRATION_DB_POOL_WAIT_MS:5000},query-timeout=${env.INTEGRATION_DB_QUERY_TIMEOUT:10},validate-on-match=true,background-validation=false,valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker,exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter,jta=true,enabled=true)
